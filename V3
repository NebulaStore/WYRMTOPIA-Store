</head>
<body class="bg-[#0b0514] text-purple-50 min-h-screen font-sans selection:bg-purple-600 selection:text-white">

  <!-- =================================================================
       AUTHENTICATION VIEW (LOGIN & REGISTER PAGE)
       ================================================================= -->
  <section id="authScreen" class="min-h-screen flex items-center justify-center p-4 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-purple-900/35 via-[#0b0514] to-[#0b0514]">
