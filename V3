    /********************************************************************
     * 7. DATA LAYER: SUPABASE CLOUD + HTTPS ZIP STORAGE UPLOAD
     ********************************************************************/
    async function loadCatalog() {
      if (useCloudSupabase) {
        const { data, error } = await supabaseClient
          .from("games")
          .select("*")
          .order("updatedAt", { ascending: false });

        if (error) {
          showStatusBanner(
            `<strong>Supabase Notice:</strong> Could not query <code>public.games</code> (${error.message}). Using local catalog fallback.`
          );
          await loadLocalCatalog();
          renderActiveView();
          return;
        }

        if (data && data.length === 0) {
          const starter = await buildStarterCatalogWithScripts();
          await supabaseClient.from("games").upsert(starter);
          gamesCatalog = starter;
        } else {
          gamesCatalog = data;
        }
      } else {
        await loadLocalCatalog();
      }
      renderActiveView();
    }

    async function loadLocalCatalog() {
      const raw = localStorage.getItem("nebula_shared_catalog");
      if (!raw) {
        const starter = await buildStarterCatalogWithScripts();
        localStorage.setItem("nebula_shared_catalog", JSON.stringify(starter));
        gamesCatalog = starter;
      } else {
        gamesCatalog = JSON.parse(raw);
      }
    }

    async function saveGameToCatalog(gameObj) {
      if (useCloudSupabase) {
        try {
          const { zipBlob } = await createZipBlobFromGame(gameObj);
          const storagePath = `${gameObj.id}/${gameObj.fileName || sanitizeIdentifier(gameObj.title) + ".zip"}`;
          const { error: uploadErr } = await supabaseClient.storage
            .from("game-builds")
            .upload(storagePath, zipBlob, {
              upsert: true,
              contentType: "application/zip"
            });

          if (!uploadErr) {
            const { data: pubUrlData } = supabaseClient.storage
              .from("game-builds")
              .getPublicUrl(storagePath);
            if (pubUrlData && pubUrlData.publicUrl) {
              gameObj.fileUrl = pubUrlData.publicUrl;
            }
          }
        } catch (storageEx) {
          console.warn("Supabase storage upload fallback:", storageEx);
        }

        const { error } = await supabaseClient.from("games").upsert(gameObj);
        if (error) {
          alert("Supabase Save Error: " + error.message);
        } else {
          await loadCatalog();
        }
      } else {
        const existingIndex = gamesCatalog.findIndex(g => g.id === gameObj.id);
        if (existingIndex !== -1) {
          gamesCatalog[existingIndex] = gameObj;
        } else {
          gamesCatalog.unshift(gameObj);
        }
        localStorage.setItem("nebula_shared_catalog", JSON.stringify(gamesCatalog));
        syncChannel.postMessage({ type: "CATALOG_UPDATED", catalog: gamesCatalog });
        renderActiveView();
      }
    }

    async function deleteGameFromCatalog(gameId) {
      if (!currentUser || !isDeveloperRole()) return;
      const game = gamesCatalog.find(g => g.id === gameId);
      if (!game) return;

      if (game.author.toLowerCase() !== currentUser.username.toLowerCase()) {
        alert("Permission Denied: You can only delete games that you uploaded.");
        return;
      }

      if (!confirm(`Are you sure you want to permanently delete "${game.title}" from WYRMTOPIA Store?`)) {
        return;
      }

      if (useCloudSupabase) {
        const { error } = await supabaseClient
          .from("games")
          .delete()
          .eq("id", gameId);
        if (error) {
          alert("Failed to delete game: " + error.message);
          return;
        }
        await loadCatalog();
      } else {
        gamesCatalog = gamesCatalog.filter(g => g.id !== gameId);
        localStorage.setItem("nebula_shared_catalog", JSON.stringify(gamesCatalog));
        syncChannel.postMessage({ type: "CATALOG_UPDATED", catalog: gamesCatalog });
        renderActiveView();
      }
    }

    /********************************************************************
     * 8. REAL-TIME SUBSCRIPTIONS
     ********************************************************************/
    function initRealtimeSync() {
      const badge = document.getElementById("syncBadge");
      if (useCloudSupabase) {
        badge.textContent = "Supabase Cloud Realtime";
        supabaseClient
          .channel("public:games")
          .on("postgres_changes", { event: "*", schema: "public", table: "games" }, () => {
            loadCatalog();
          })
          .subscribe();
      } else {
        badge.textContent = "Multi-Tab Live Sync (Local)";
      }

      syncChannel.onmessage = (event) => {
        if (event.data && event.data.type === "CATALOG_UPDATED") {
          gamesCatalog = event.data.catalog;
          renderActiveView();
        }
      };
    }

