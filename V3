                <div class="text-xs text-purple-300/70">Full access to play/download games and publish/configure your own games.</div>
              </div>
            </label>
          </div>
        </div>

        <button id="regSubmitBtn" type="submit" class="w-full py-2.5 px-4 rounded-xl bg-purple-700 hover:bg-purple-600 transition font-semibold text-sm text-white shadow-lg shadow-purple-700/30">
          Create Account & Enter Store
        </button>
