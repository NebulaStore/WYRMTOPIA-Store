        if (tab === filterName) {
          btn.className = "px-4 py-2 rounded-lg text-sm font-medium bg-purple-700 text-white flex items-center gap-2 shadow-md shadow-purple-900/40";
        } else if (tab === "dev_studio") {
          btn.className = "px-4 py-2 rounded-lg text-sm font-medium bg-[#180c2c] text-fuchsia-300 border border-purple-600/40 hover:bg-purple-900/50 flex items-center gap-2";
        } else {
          btn.className = "px-4 py-2 rounded-lg text-sm font-medium bg-[#180c2c] text-purple-200/80 hover:bg-purple-900/50 border border-purple-900/50 flex items-center gap-2";
        }
      });
      renderActiveView();
    }

    function openUploadModal() {
      if (!isDeveloperRole()) {
        alert("Only Developer accounts can upload games.");
        return;
      }
      document.getElementById("modalTitle").textContent = "Upload Game, Logo & Website Redirect";
      document.getElementById("editGameId").value = "";
      document.getElementById("uploadForm").reset();
      document.getElementById("gameRedirectUrl").value = "";
      selectedUploadFiles = [];
      detectedLogoDataUrl = null;
      detectedLogoFileName = null;
      document.getElementById("logoPreviewBox").classList.add("hidden");
      document.getElementById("virusScanPanel").classList.add("hidden");
      document.getElementById("selectedFilesList").innerHTML = "";
      document.getElementById("submitBtn").disabled = false;
      document.getElementById("gameVersion").value = "1.0.0";
      document.getElementById("uploadModal").classList.remove("hidden");
      document.getElementById("uploadModal").classList.add("flex");
    }

    function openConfigureModalForGame(gameId) {
      if (!isDeveloperRole()) return;
      const game = gamesCatalog.find(g => g.id === gameId);
      if (!game) return;

      if (game.author.toLowerCase() !== currentUser.username.toLowerCase()) {
        alert("Permission Denied: You can only configure games created by your account.");
        return;
      }

      const parts = game.version.split(".");
      if (parts.length === 3 && !isNaN(parts[2])) {
        parts[2] = Number(parts[2]) + 1;
      }
      const nextVersion = parts.join(".");

      document.getElementById("modalTitle").textContent = `Configure / Push Update for "${game.title}"`;
      document.getElementById("editGameId").value = game.id;
      document.getElementById("gameTitle").value = game.title;
      document.getElementById("gameVersion").value = nextVersion;
      document.getElementById("gameGenre").value = game.genre;
      document.getElementById("gameCover").value = (game.cover && !game.cover.startsWith("data:")) ? game.cover : "";
      document.getElementById("gameRedirectUrl").value = getGameRedirectUrl(game);
      document.getElementById("gameDesc").value = game.description;
      document.getElementById("gameFile").value = "";
      document.getElementById("gameFolder").value = "";
      selectedUploadFiles = [];
      detectedLogoDataUrl = null;
      detectedLogoFileName = null;
      document.getElementById("logoPreviewBox").classList.add("hidden");
      document.getElementById("virusScanPanel").classList.add("hidden");
      document.getElementById("selectedFilesList").innerHTML = "";
      document.getElementById("submitBtn").disabled = false;

      document.getElementById("uploadModal").classList.remove("hidden");
      document.getElementById("uploadModal").classList.add("flex");
    }

    function closeUploadModal() {
      document.getElementById("uploadModal").classList.add("hidden");
      document.getElementById("uploadModal").classList.remove("flex");
    }

    async function handlePublishGame(e) {
      e.preventDefault();
      if (!isDeveloperRole()) return;

      const submitBtn = document.getElementById("submitBtn");
      submitBtn.disabled = true;
      submitBtn.textContent = "Publishing to Store...";

      try {
        const scanResult = await runLiveFileVirusScan();
        if (!scanResult.passed) {
          alert(
            "⛔ WyrmShield Antivirus Blocked Upload:\n\n" +
            scanResult.threats.join("\n")
          );
          return;
        }

        const editId = document.getElementById("editGameId").value;
        const existingGame = editId ? gamesCatalog.find(g => g.id === editId) : null;

        if (existingGame && existingGame.author.toLowerCase() !== currentUser.username.toLowerCase()) {
          alert("Permission Denied: You cannot modify another developer's game.");
          return;
        }

        const title = document.getElementById("gameTitle").value.trim();
        const version = document.getElementById("gameVersion").value.trim();
        const genre = document.getElementById("gameGenre").value;
        let cover = document.getElementById("gameCover").value.trim();
        const redirectUrl = normalizeExternalUrl(document.getElementById("gameRedirectUrl").value);
        const description = document.getElementById("gameDesc").value.trim();
        const files = selectedUploadFiles;

        if (detectedLogoDataUrl) {
          cover = detectedLogoDataUrl;
        } else if (!cover && existingGame && existingGame.cover) {
          cover = existingGame.cover;
        }

        let archiveFileName;
        let launcherScript;
        let bundledFiles;
        let fileSize;

        if (existingGame && files.length === 0 && existingGame.launcherScript) {
          const updatedPkg = updateExistingPackageRedirectUrl(existingGame, title, version, redirectUrl);
          archiveFileName = updatedPkg.archiveFileName;
          launcherScript = updatedPkg.launcherScript;
          bundledFiles = updatedPkg.bundledFiles;
          fileSize = existingGame.fileSize || (redirectUrl ? "Website Link + Bundle" : "HTTPS .ZIP Bundle");
        } else {
          const totalBytes = files.reduce((acc, f) => acc + f.size, 0);
          if (files.length > 0 && redirectUrl) {
            fileSize = `Web Link + .ZIP (${(totalBytes / 1024).toFixed(1)} KB)`;
          } else if (files.length > 0) {
            fileSize = `HTTPS .ZIP • ${files.length} file(s) (${(totalBytes / 1024).toFixed(1)} KB)`;
          } else if (redirectUrl) {
            fileSize = "🌐 Direct Website Redirect";
          } else {
            fileSize = "Verified .ZIP Bundle";
          }

          const pkg = await buildWebFolderPackage(
            files,
            title,
            version,
            currentUser.username,
            description,
            scanResult.files,
            redirectUrl
          );
          archiveFileName = pkg.archiveFileName;
          launcherScript = pkg.launcherScript;
          bundledFiles = pkg.bundledFiles;
        }

        const gameObj = {
          id: editId || `game_${Date.now()}`,
          title,
          author: currentUser.username,
          genre,
          version,
          description,
          cover,
          fileName: archiveFileName,
          fileSize,
          bundledFiles,
          launcherScript,
          fileUrl: existingGame ? existingGame.fileUrl : null,
          updatedAt: new Date().toISOString()
        };

        await saveGameToCatalog(gameObj);
        closeUploadModal();
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "Publish to WYRMTOPIA Store";
      }
    }

    // Boot application & restore active session
    initRealtimeSync();
    (function restoreSessionOnBoot() {
      const saved = localStorage.getItem("nebula_active_session");
      if (saved) {
        try {
          const parsed = JSON.parse(saved);
          if (parsed && parsed.username && parsed.role) {
            completeLoginSession(parsed);
          }
        } catch (_) {}
      }
    })();
  </script>
</body>
