      <!-- Brand Header -->
      <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-purple-600 to-fuchsia-800 flex items-center justify-center font-extrabold text-xl text-white shadow-lg shadow-purple-600/30 border border-purple-400/20">
          W
        </div>
        <div>
          <h1 class="text-xl font-bold tracking-tight text-white">WYRMTOPIA Store</h1>
          <p class="text-xs text-purple-300/70">Direct HTTPS Cloud Storage • Web Redirects • Auto-Logo Shop</p>
        </div>
      </div>

      <!-- Mode Switcher Tabs -->
      <div class="grid grid-cols-2 gap-2 p-1 bg-[#0c0517] rounded-xl border border-purple-900/70 mb-6">
        <button id="authTabLogin" type="button" onclick="switchAuthMode('login')" class="py-2 rounded-lg text-sm font-semibold bg-purple-700 text-white transition shadow-md shadow-purple-900/40">
          Sign In
        </button>
        <button id="authTabRegister" type="button" onclick="switchAuthMode('register')" class="py-2 rounded-lg text-sm font-semibold text-purple-300/70 hover:text-white transition">
          Register Account
        </button>
      </div>

      <!-- Auth Error / Info Alert -->
      <div id="authMessage" class="hidden mb-4 p-3 rounded-lg text-xs font-medium"></div>

      <!-- LOGIN FORM -->
