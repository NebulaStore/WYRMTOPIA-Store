    </div>
  </section>

  <!-- =================================================================
       MAIN APPLICATION VIEW (STOREFRONT + DEVELOPER STUDIO)
       ================================================================= -->
  <div id="appScreen" class="hidden min-h-screen flex flex-col">

    <!-- Top Navigation -->
    <header class="border-b border-purple-900/60 bg-[#120822]/90 backdrop-blur sticky top-0 z-30">
      <div class="max-w-6xl mx-auto px-6 py-4 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-purple-600 to-fuchsia-800 flex items-center justify-center font-extrabold text-lg text-white shadow-lg shadow-purple-600/30 border border-purple-400/20">
