    async function runLiveFileVirusScan(skippedBatCount = 0) {
      const panel = document.getElementById("virusScanPanel");
      const previewEl = document.getElementById("selectedFilesList");
      const statusBadge = document.getElementById("virusScanStatusBadge");
      const progressBar = document.getElementById("virusScanProgressBar");
      const submitBtn = document.getElementById("submitBtn");

      const files = selectedUploadFiles;
      if (files.length === 0) {
        panel.classList.add("hidden");
        previewEl.innerHTML = "";
        lastScanResult = { passed: true, files: [], threats: [] };
        submitBtn.disabled = false;
        return lastScanResult;
      }

      panel.classList.remove("hidden");
      statusBadge.textContent = "Scanning Files...";
      statusBadge.className = "px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-purple-500/20 text-purple-300";
      progressBar.style.width = "25%";
      progressBar.className = "h-full bg-purple-500 transition-all duration-300";

      const scannedFiles = [];
      const allThreats = [];
      let hasExe = false;

      for (let i = 0; i < files.length; i++) {
        const res = await scanSingleFile(files[i]);
        if (res.ext === "exe") hasExe = true;

        scannedFiles.push(res);
        if (!res.clean) {
          allThreats.push(...res.threats.map(t => `${res.name}:${t}`));
        }
        progressBar.style.width = `${Math.round(((i + 1) / files.length) * 100)}%`;
      }

      const passed = allThreats.length === 0;
      lastScanResult = { passed, files: scannedFiles, threats: allThreats };

      if (passed) {
        statusBadge.textContent = "✓ Verified Clean";
        statusBadge.className = "px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-500/20 text-emerald-300 border border-emerald-500/30";
        progressBar.className = "h-full bg-emerald-500 transition-all duration-300";
        submitBtn.disabled = false;
      } else {
        statusBadge.textContent = "⛔ Threat Blocked";
        statusBadge.className = "px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-rose-500/20 text-rose-300 border border-rose-500/30";
        progressBar.className = "h-full bg-rose-500 transition-all duration-300";
        submitBtn.disabled = true;
      }

      const skippedNotice = skippedBatCount > 0
        ? `<div class="text-amber-300 bg-amber-950/40 border border-amber-500/30 px-2.5 py-1 rounded text-[10px]">
             🛡️ Auto-excluded ${skippedBatCount} <code>.bat/.cmd</code> file(s) so Windows Defender never blocks your game!
           </div>`
        : "";

      const exeNotice = hasExe
        ? `<div class="text-purple-200 bg-purple-950/50 border border-purple-500/30 px-2.5 py-1 rounded text-[10px]">
             🎯 Native Windows <code>.exe</code> verified — will be hosted on Supabase HTTPS Storage.
           </div>`
        : "";

      const logoNotice = detectedLogoFileName
        ? `<div class="text-emerald-300 bg-emerald-950/30 border border-emerald-500/20 px-2.5 py-1 rounded text-[10px]">
             🎨 Uploaded Logo (<code>${detectedLogoFileName}</code>) will be used as the Game Photo in WYRMTOPIA Store!
           </div>`
        : "";

      previewEl.innerHTML =
        skippedNotice +
        exeNotice +
        logoNotice +
        scannedFiles.map(f => {
          if (f.clean) {
            return `
              <div class="flex items-center justify-between gap-2 text-emerald-300 bg-emerald-950/30 border border-emerald-500/20 px-2.5 py-1 rounded">
                <span class="truncate">✓ ${f.name} (${f.sizeKB} KB)</span>
                <span class="text-[10px] text-purple-300/60 shrink-0">SHA256: ${f.shortHash}…</span>
              </div>
            `;
          } else {
            return `
              <div class="text-rose-300 bg-rose-950/40 border border-rose-500/30 px-2.5 py-1.5 rounded space-y-0.5">
                <div class="font-bold">⛔ ${f.name} — BLOCKED BY WYRMSHIELD</div>
                <div class="text-[10px] text-rose-200">${f.threats.join(" | ")}</div>
              </div>
            `;
          }
        }).join("");

      return lastScanResult;
    }

