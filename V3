    /********************************************************************
     * 6. LOCAL INSTALLED LIBRARY TRACKER (PER LOGGED-IN USERNAME)
     ********************************************************************/
    function getInstalledLibrary() {
      if (!currentUser) return {};
      const raw = localStorage.getItem(`nebula_installed_${currentUser.username}`);
      return raw ? JSON.parse(raw) : {};
    }

    function setInstalledVersion(gameId, version) {
      if (!currentUser) return;
      const lib = getInstalledLibrary();
      lib[gameId] = {
