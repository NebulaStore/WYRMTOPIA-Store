          Sign In to WYRMTOPIA Store
        </button>
      </form>

      <!-- REGISTER FORM -->
      <form id="registerForm" onsubmit="handleRegister(event)" class="space-y-4 hidden">
        <div>
          <label class="block text-xs text-purple-300/80 mb-1">Choose a Username *</label>
          <input id="regUsername" required type="text" placeholder="e.g., wyrm_dev or gamer_max" class="w-full bg-[#0c0517] border border-purple-900/70 rounded-lg px-3.5 py-2.5 text-sm text-white placeholder-purple-400/40 focus:outline-none focus:border-purple-500" />
        </div>
        <div>
          <label class="block text-xs text-purple-300/80 mb-1">Create Password *</label>
          <input id="regPassword" required type="password" minlength="3" placeholder="At least 3 characters" class="w-full bg-[#0c0517] border border-purple-900/70 rounded-lg px-3.5 py-2.5 text-sm text-white placeholder-purple-400/40 focus:outline-none focus:border-purple-500" />
        </div>

        <!-- Role Selector -->
        <div>
          <label class="block text-xs text-purple-300/80 mb-2">Select Account Type *</label>
          <div class="space-y-2">
            <label class="flex items-start gap-3 p-3 rounded-xl border border-purple-900/70 bg-[#0c0517] cursor-pointer hover:border-purple-500/70 transition">
              <input type="radio" name="regRole" value="player" checked class="mt-1 accent-purple-600" />
              <div>
                <div class="text-sm font-semibold text-white">Player</div>
                <div class="text-xs text-purple-300/70">Browse the store, download game .ZIPs, or launch game websites directly.</div>
              </div>
            </label>

            <label class="flex items-start gap-3 p-3 rounded-xl border border-purple-900/70 bg-[#0c0517] cursor-pointer hover:border-purple-500/70 transition">
              <input type="radio" name="regRole" value="developer" class="mt-1 accent-purple-600" />
              <div>
