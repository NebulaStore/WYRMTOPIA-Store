    async function handleRegister(e) {
      e.preventDefault();
      showAuthMessage("");

      const username = document.getElementById("regUsername").value.trim();
      const password = document.getElementById("regPassword").value;
      const role = document.querySelector('input[name="regRole"]:checked').value;

      if (!username || !password) {
        showAuthMessage("Please enter both a username and password.");
        return;
      }

      const regBtn = document.getElementById("regSubmitBtn");
      regBtn.disabled = true;
      regBtn.textContent = "Creating Account...";

      try {
        const normalizedUsername = username;

        if (useCloudSupabase) {
          const { data: existingCloud, error: checkErr } = await supabaseClient
            .from("store_users")
            .select("username")
            .ilike("username", normalizedUsername)
            .maybeSingle();

          if (!checkErr && existingCloud) {
            showAuthMessage("That username is already taken. Please choose another or sign in.");
            return;
          }

          if (!checkErr) {
            const { error: insertErr } = await supabaseClient
              .from("store_users")
              .insert({
                username: normalizedUsername,
                password: password,
                role: role
              });

            if (insertErr) {
              showAuthMessage("Registration error: " + insertErr.message);
              return;
            }
          }
        }

        const localUsers = getLocalUsersMap();
        if (localUsers[normalizedUsername.toLowerCase()]) {
          showAuthMessage("That username is already registered.");
          return;
        }

        const newUser = { username: normalizedUsername, password, role };
        saveLocalUser(newUser);

        completeLoginSession({ username: normalizedUsername, role });
      } finally {
        regBtn.disabled = false;
        regBtn.textContent = "Create Account & Enter Store";
      }
    }

    async function handleLogin(e) {
      e.preventDefault();
      showAuthMessage("");

      const username = document.getElementById("loginUsername").value.trim();
      const password = document.getElementById("loginPassword").value;

      const loginBtn = document.getElementById("loginSubmitBtn");
      loginBtn.disabled = true;
      loginBtn.textContent = "Signing In...";

      try {
        if (useCloudSupabase) {
          const { data: cloudUser, error } = await supabaseClient
            .from("store_users")
            .select("*")
            .ilike("username", username)
            .maybeSingle();

          if (!error && cloudUser) {
            if (cloudUser.password !== password) {
              showAuthMessage("Incorrect password. Please try again.");
              return;
            }
            saveLocalUser(cloudUser);
            completeLoginSession({ username: cloudUser.username, role: cloudUser.role });
            return;
          }
        }

        const localUsers = getLocalUsersMap();
        const foundLocal = localUsers[username.toLowerCase()];
        if (!foundLocal) {
          showAuthMessage("Account not found. Click 'Register Account' above to create one.");
          return;
        }
        if (foundLocal.password !== password) {
          showAuthMessage("Incorrect password. Please try again.");
          return;
        }

        completeLoginSession({ username: foundLocal.username, role: foundLocal.role });
      } finally {
        loginBtn.disabled = false;
        loginBtn.textContent = "Sign In to WYRMTOPIA Store";
      }
    }

