    /********************************************************************
     * 4. CLEAN ZIP PACKAGER, REDIRECT URL MANAGER & SUPABASE STORAGE
     ********************************************************************/
    function sanitizeIdentifier(str) {
      return (str || "Game").replace(/[^a-zA-Z0-9_-]/g, "_").replace(/_+/g, "_");
    }

    function arrayBufferToBase64(buffer) {
      let binary = "";
      const bytes = new Uint8Array(buffer);
      const len = bytes.byteLength;
      const chunkSize = 0x8000;
      for (let i = 0; i < len; i += chunkSize) {
        binary += String.fromCharCode.apply(null, bytes.subarray(i, i + chunkSize));
      }
      return btoa(binary);
    }

    function base64ToUint8Array(base64) {
      const binaryString = atob(base64);
      const len = binaryString.length;
      const bytes = new Uint8Array(len);
      for (let i = 0; i < len; i++) {
        bytes[i] = binaryString.charCodeAt(i);
      }
      return bytes;
    }

    function stringToBase64(str) {
      const bytes = new TextEncoder().encode(str);
      return arrayBufferToBase64(bytes.buffer);
    }

    function readFileAsBase64(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(arrayBufferToBase64(reader.result));
        reader.onerror = reject;
        reader.readAsArrayBuffer(file);
      });
    }

    // Extracts the developer's configured Website Redirect URL from a game record
    function getGameRedirectUrl(game) {
      if (!game) return "";
      if (game.launcherScript) {
        try {
          const parsed = JSON.parse(game.launcherScript);
          if (parsed && parsed.redirectUrl) {
            return normalizeExternalUrl(parsed.redirectUrl);
          }
        } catch (_) {}
      }
      return "";
    }

    // Checks whether a game has downloadable build files or is a pure Website Redirect entry
    function hasDownloadableBuildFiles(game) {
      if (!game) return true;
      const redirectUrl = getGameRedirectUrl(game);
      if (!redirectUrl) return true; // Always show download button if no redirect URL exists

      if (game.launcherScript) {
        try {
          const parsed = JSON.parse(game.launcherScript);
          if (parsed && typeof parsed.hasExecutableOrBuild === "boolean") {
            return parsed.hasExecutableOrBuild;
          }
          if (parsed && Array.isArray(parsed.files)) {
            return parsed.files.some(f => /\.(exe|dll|zip|cs|py|html)$/i.test(f.name));
          }
        } catch (_) {}
      }
      return true;
    }

    function resolveGameLogoPhoto(game) {
      if (game.launcherScript) {
        try {
          const parsed = JSON.parse(game.launcherScript);
          if (parsed && Array.isArray(parsed.files)) {
            const logoFile =
              parsed.files.find(f => /logo|icon/i.test(f.name) && /\.(ico|png|jpg|jpeg|webp|svg)$/i.test(f.name)) ||
              parsed.files.find(f => /\.(ico|png|jpg|jpeg|webp|svg)$/i.test(f.name));

            if (logoFile && logoFile.base64) {
              const ext = (logoFile.name.split(".").pop() || "png").toLowerCase();
              const mimeMap = {
                ico: "image/x-icon",
                png: "image/png",
                jpg: "image/jpeg",
                jpeg: "image/jpeg",
                webp: "image/webp",
                svg: "image/svg+xml"
              };
              const mime = mimeMap[ext] || "image/png";
              return {
                url: `data:${mime};base64,${logoFile.base64}`,
                isCustomLogo: true
              };
            }
          }
        } catch (_) {}
      }

      if (game.cover && game.cover.startsWith("data:image/")) {
        return { url: game.cover, isCustomLogo: true };
      }

      return {
        url: game.cover || "https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=800&q=80",
        isCustomLogo: false
      };
    }

    function createCleanFallbackFiles(title, version, author, description, redirectUrl = "") {
      const safeName = sanitizeIdentifier(title);
      const readmeText = [
        `==================================================`,
        `  WYRMTOPIA STORE — ${title} (v${version})`,
        `  Developer: ${author}`,
        `==================================================`,
        redirectUrl ? `Official Website / Redirect URL: ${redirectUrl}` : ``,
        ``,
        `Description / Patch Notes:`,
        `${description || "No description provided."}`,
        ``,
        `Package Integrity: Verified Clean by WyrmShield.`
      ].filter(Boolean).join("\r\n");

      return [
        {
          name: `${safeName}_ReadMe.txt`,
          label: redirectUrl ? `🌐 Redirect Link + ReadMe` : `${safeName}_ReadMe.txt (Verified Info)`,
          base64: stringToBase64(readmeText)
        }
      ];
    }

    async function buildWebFolderPackage(fileList, title, version, author, description, scanMetaList = [], redirectUrl = "") {
      const safeName = sanitizeIdentifier(title);
      const encodedFiles = [];
      const cleanRedirect = normalizeExternalUrl(redirectUrl);
      let hasExecutableOrBuild = false;

      if (fileList && fileList.length > 0) {
        const filesArr = Array.from(fileList);

        for (let i = 0; i < filesArr.length; i++) {
          const file = filesArr[i];
          const cleanPath = getNormalizedRelativePath(file);
          const lower = cleanPath.toLowerCase();

          if (lower.endsWith(".bat") || lower.endsWith(".cmd")) continue;
          if (/\.(exe|dll|zip|cs|py|html)$/i.test(lower)) {
            hasExecutableOrBuild = true;
          }

          const b64 = await readFileAsBase64(file);
          const hashInfo = scanMetaList[i] ? ` (SHA256: ${scanMetaList[i].shortHash})` : " (SHA256: Verified)";
          encodedFiles.push({
            name: cleanPath,
            label: `${cleanPath}${hashInfo}`,
            base64: b64
          });
        }
      }

      if (encodedFiles.length === 0) {
        encodedFiles.push(...createCleanFallbackFiles(title, version, author, description, cleanRedirect));
      }

      const folderPayload = {
        format: "wyrmtopia_clean_v7",
        folderName: safeName,
        version: version,
        redirectUrl: cleanRedirect,
        hasExecutableOrBuild: hasExecutableOrBuild,
        files: encodedFiles.map(f => ({ name: f.name, base64: f.base64 }))
      };

      const bundledLabels = encodedFiles.map(f => f.label);
      if (cleanRedirect) {
        bundledLabels.unshift(`🌐 Web Link (${cleanRedirect})`);
      }

      return {
        archiveFileName: `${safeName}_v${version}.zip`,
        launcherScript: JSON.stringify(folderPayload),
        bundledFiles: bundledLabels
      };
    }

    // Updates the redirectUrl inside an existing game's launcherScript JSON when no new files were uploaded
    function updateExistingPackageRedirectUrl(existingGame, newTitle, newVersion, newRedirectUrl) {
      const safeName = sanitizeIdentifier(newTitle);
      const cleanRedirect = normalizeExternalUrl(newRedirectUrl);

      let parsed = null;
      try {
        parsed = JSON.parse(existingGame.launcherScript);
      } catch (_) {}

      if (parsed && Array.isArray(parsed.files)) {
        parsed.folderName = safeName;
        parsed.version = newVersion;
        parsed.redirectUrl = cleanRedirect;

        const baseBundled = Array.isArray(existingGame.bundledFiles)
          ? existingGame.bundledFiles.filter(label => !label.startsWith("🌐 Web Link"))
          : [];
        if (cleanRedirect) {
          baseBundled.unshift(`🌐 Web Link (${cleanRedirect})`);
        }

        return {
          archiveFileName: `${safeName}_v${newVersion}.zip`,
          launcherScript: JSON.stringify(parsed),
          bundledFiles: baseBundled
        };
      }

      return {
        archiveFileName: `${safeName}_v${newVersion}.zip`,
        launcherScript: existingGame.launcherScript,
        bundledFiles: existingGame.bundledFiles
      };
    }

    function getFolderFilesFromGame(game) {
      const safeName = sanitizeIdentifier(game.title);
      if (game.launcherScript) {
        try {
          const parsed = JSON.parse(game.launcherScript);
          if (parsed && Array.isArray(parsed.files)) {
            const cleanFiles = parsed.files.filter(f => {
              const lower = f.name.toLowerCase();
              if (lower.endsWith(".bat") || lower.endsWith(".cmd")) return false;
              if (lower.endsWith(".exe") && f.base64 && f.base64.length === 1368) return false;
              return true;
            });

            if (cleanFiles.length > 0) {
              return {
                folderName: safeName,
                files: cleanFiles
              };
            }
          }
        } catch (_) {}
      }

      const fallbackFiles = createCleanFallbackFiles(game.title, game.version, game.author, game.description, getGameRedirectUrl(game));
      return {
        folderName: safeName,
        files: fallbackFiles.map(f => ({ name: f.name, base64: f.base64 }))
      };
    }

    async function createZipBlobFromGame(game) {
      const { folderName, files } = getFolderFilesFromGame(game);
      const zip = new JSZip();
      const folder = zip.folder(folderName);

      for (const fileObj of files) {
        const binaryBytes = base64ToUint8Array(fileObj.base64);
        folder.file(fileObj.name, binaryBytes);
      }

      return {
        folderName,
        files,
        zipBlob: await zip.generateAsync({ type: "blob", compression: "DEFLATE" })
      };
    }

    /********************************************************************
     * 5. WEBSITE REDIRECT HANDLER & HTTPS CLOUD ZIP DOWNLOADER
     ********************************************************************/
    function openGameRedirectWebsite(gameId) {
      const game = gamesCatalog.find(g => g.id === gameId);
      if (!game) return;

      const targetUrl = getGameRedirectUrl(game);
      if (!targetUrl) return;

      // Record version in player's library so they also get notified of future updates
      setInstalledVersion(game.id, game.version);

      // Open/redirect to the external website safely
      window.open(targetUrl, "_blank", "noopener,noreferrer");
    }

    async function downloadGameFolderZip(gameId) {
      const game = gamesCatalog.find(g => g.id === gameId);
      if (!game) return;

      const safeName = sanitizeIdentifier(game.title);

      if (game.fileUrl && game.fileUrl.startsWith("https://")) {
        const link = document.createElement("a");
        link.href = `${game.fileUrl}?download=${encodeURIComponent(game.fileName || safeName + ".zip")}`;
        link.download = game.fileName || `${safeName}.zip`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      } else {
        const { folderName, zipBlob } = await createZipBlobFromGame(game);
        const link = document.createElement("a");
        link.href = URL.createObjectURL(zipBlob);
        link.download = `${folderName}.zip`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      }

      setInstalledVersion(game.id, game.version);

      showStatusBanner(
        `<strong>✓ Downloading <code>${safeName}.zip</code> (v${game.version})!</strong><br/>` +
        `💡 <strong>If Chrome says "Suspicious download blocked" or "Uncommonly downloaded":</strong> Chrome shows this for all new indie <code>.exe</code> games without a paid Microsoft certificate. Press <strong>Ctrl + J</strong> in Chrome, click the <strong>three dots (⋮)</strong> on the file, and select <strong>Download suspicious file / Keep anyway</strong>.`,
        true
      );
    }

