  <script>
    /********************************************************************
     * 1. SERVERLESS CONFIGURATION (CONNECTED TO YOUR SUPABASE PROJECT)
     ********************************************************************/
    const SUPABASE_URL = "https://oirhhzmhkomcqbffqfny.supabase.co";
    const SUPABASE_ANON_KEY = "sb_publishable_5bEZnUlGpFbjrSg8wtvmbw_vCMagphO";

    const useCloudSupabase = Boolean(SUPABASE_URL && SUPABASE_ANON_KEY);
    const supabaseClient = useCloudSupabase
      ? window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY)
      : null;

    const syncChannel = new BroadcastChannel("nebula_store_realtime_sync");

    let gamesCatalog = [];
    let activeFilter = "all";
    let currentUser = null;
    let selectedUploadFiles = [];
    let detectedLogoDataUrl = null;
    let detectedLogoFileName = null;
    let lastScanResult = { passed: true, files: [], threats: [] };

    function isDeveloperRole() {
      return currentUser && (currentUser.role === "developer" || currentUser.role === "both");
    }

    function showStatusBanner(htmlMessage, isSuccess = false) {
      const banner = document.getElementById("statusBanner");
      if (!htmlMessage) {
        banner.classList.add("hidden");
        banner.innerHTML = "";
      } else {
        banner.innerHTML = htmlMessage;
        banner.className = isSuccess
          ? "mb-6 p-4 rounded-xl border border-emerald-500/40 bg-emerald-500/10 text-emerald-300 text-xs leading-relaxed"
          : "mb-6 p-4 rounded-xl border border-amber-500/40 bg-amber-500/10 text-amber-300 text-xs leading-relaxed";
      }
    }

    // Normalizes any user-entered URL so it always starts with https:// or http://
    function normalizeExternalUrl(rawUrl) {
      const trimmed = (rawUrl || "").trim();
      if (!trimmed) return "";
      if (/^https?:\/\//i.test(trimmed)) return trimmed;
      return `https://${trimmed}`;
    }

    /********************************************************************
     * 2. WYRMSHIELD AUTO VIRUS & PE32 .EXE VERIFIER
     ********************************************************************/
    const MALWARE_SIGNATURES = [
      {
        name: "Test Virus Trigger (EICAR / WyrmShield Test)",
        regex: /NEBULA_TEST_VIRUS_SIGNATURE|X5O!P%@AP\[4\\PZX54\(P\^\)7CC\)7\}\$EICAR/i,
        severity: "CRITICAL — Test Virus Signature Detected"
      },
      {
        name: "Destructive Disk Format Command",
        regex: /\bformat\s+[a-z]:\s*(\/q|\/y|\/fs)/i,
        severity: "CRITICAL — Unauthorized Drive Format Command"
      },
      {
        name: "Recursive System Root Wipe",
        regex: /\b(rd|rmdir|del|erase)\s+\/[sSqQ]+\s+.*[cC]:\\(Windows|System32|Users)/i,
        severity: "CRITICAL — Destructive System File Deletion"
      },
      {
        name: "Obfuscated Hidden PowerShell Payload",
        regex: /powershell.*(-enc|-encodedcommand)\s+[A-Za-z0-9+/=]{20,}/i,
        severity: "HIGH — Obfuscated Encoded PowerShell Payload"
      }
    ];

    async function computeFileSHA256(arrayBuffer) {
      const hashBuffer = await crypto.subtle.digest("SHA-256", arrayBuffer);
      const hashArray = Array.from(new Uint8Array(hashBuffer));
      return hashArray.map(b => b.toString(16).padStart(2, "0")).join("");
    }

    function getNormalizedRelativePath(file) {
      if (file.webkitRelativePath && file.webkitRelativePath.includes("/")) {
        const parts = file.webkitRelativePath.split("/");
        const innerPath = parts.slice(1).join("/");
        return innerPath.replace(/[^a-zA-Z0-9._/-]/g, "_");
      }
      return file.name.replace(/[^a-zA-Z0-9._-]/g, "_");
    }

    function readFileAsDataURL(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    async function scanSingleFile(file) {
      const buffer = await file.arrayBuffer();
      const sha256 = await computeFileSHA256(buffer);
      const shortHash = sha256.slice(0, 12);
      const relPath = getNormalizedRelativePath(file);
      const ext = (relPath.split(".").pop() || "").toLowerCase();
      const threatsFound = [];

      if (["cs", "py", "html", "txt", "js", "json"].includes(ext)) {
        const textContent = new TextDecoder("utf-8", { fatal: false }).decode(buffer);
        for (const sig of MALWARE_SIGNATURES) {
          if (sig.regex.test(textContent)) {
            threatsFound.push(`${sig.name} (${sig.severity})`);
          }
        }
      }

      if (ext === "exe" || ext === "dll") {
        const bytes = new Uint8Array(buffer);
        if (bytes.length < 2 || bytes[0] !== 0x4D || bytes[1] !== 0x5A) {
          threatsFound.push("Invalid Windows PE Binary (Missing 'MZ' Executable Header)");
        }
        const rawText = new TextDecoder("utf-8", { fatal: false }).decode(buffer);
        for (const sig of MALWARE_SIGNATURES) {
          if (sig.regex.test(rawText)) {
            threatsFound.push(`${sig.name} (${sig.severity})`);
          }
        }
      }

      return {
        name: relPath,
        ext,
        sizeKB: (file.size / 1024).toFixed(1),
        sha256,
        shortHash,
        clean: threatsFound.length === 0,
        threats: threatsFound
      };
    }

